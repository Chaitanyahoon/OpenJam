# ========================================
# OPEN JAM — CONFIGURATION
# ========================================

# Security Key (generate: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=generate-random-secure-key-here

# Administrative Password for /admin maintenance panel.
# Must be set to a secure custom value in production.
ADMIN_PASSWORD=openjam-admin-123

# Runtime mode: development or production
ENVIRONMENT=development

# Database
# Leave blank to use a safe OS-local SQLite path.
# On Windows this defaults to AppData/Local/OpenJam/openjam.db.
#
# For PostgreSQL (e.g. Supabase):
#   Use port 6543 (PgBouncer transaction pooler):
#   postgresql://user:pass@host:6543/dbname
#
#   PgBouncer allows many users with the free-tier 2-connection limit.
#   Without PgBouncer (port 5432), pool_size must be ≤ 2 for free tier.
DATABASE_URL=

# CORS origins, comma-separated
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000,https://openjam.onrender.com

# Optional: Redis URL for production state management
# REDIS_URL=

# ========================================
# STREAMING CONFIGURATION (Optional)
# ========================================

# YouTube cookies in Netscape format (helps yt-dlp bypass bot detection on cloud)
# Export from browser using "Get cookies.txt LOCALLY" extension
# Paste the file contents as a single string with literal \n for newlines
YOUTUBE_COOKIES=

# Cobalt API URL for YouTube audio extraction (self-host recommended)
# Self-host guide: https://github.com/imputnet/cobalt
# Public (rate-limited): https://api.cobalt.tools
COBALT_API_URL=

# ========================================
# DISCORD OAUTH2 LOGIN (Optional)
# ========================================

# Create an app at https://discord.com/developers/applications
# Under OAuth2 > Redirects, add your callback URL
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_REDIRECT_URI=http://localhost:8000/auth/discord/callback

# ========================================
# NOTES:
# ========================================
# ✓ No YouTube API Key needed! Track resolution uses ytmusicapi (quota-free)
# ✓ Album art & metadata uses Apple's iTunes API (no key required)
# ✓ Recommendations are powered by iTunes Top Charts (no authentication)
# ✓ Streaming uses 4-layer fallback: yt-dlp → Cobalt → Invidious → Piped
# ✓ Discord login is optional — guests can still join anonymously
