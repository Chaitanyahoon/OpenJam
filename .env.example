# ========================================
# OPEN JAM — CONFIGURATION
# ========================================

# Security Key (generate: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=generate-random-secure-key-here

# Runtime mode: development or production
ENVIRONMENT=development

# Database
# Leave blank to use a safe OS-local SQLite path.
# On Windows this defaults to AppData/Local/OpenJam/openjam.db.
# For PostgreSQL (e.g. Supabase): postgresql://user:pass@host:port/dbname
DATABASE_URL=

# CORS origins, comma-separated
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000,https://openjam.onrender.com

# ========================================
# NOTES:
# ========================================
# ✓ No YouTube API Key needed! Track resolution uses ytmusicapi (quota-free)
# ✓ Album art & metadata uses Apple's iTunes API (no key required)
# ✓ Recommendations are powered by iTunes Top Charts (no authentication)
